# Copy to .env and fill only the values you own. Never commit real secrets.
# NVIDIA NIM wird bevorzugt, wenn NIM_API_KEY gesetzt ist; Ollama bleibt Fallback.
JARVIS_PROVIDER=auto
OMNIROUTE_API_URL=http://127.0.0.1:20128/v1/chat/completions
OMNIROUTE_MODEL=auto
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
# Leer lassen = automatisch alle kostenlosen OpenRouter-Modelle mit :free laden.
OPENROUTER_MODELS=
NIM_API_KEY=
NIM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
NIM_MODEL=meta/llama-3.1-8b-instruct
# Reihenfolge = bevorzugt bis zuletzt; nur Modelle aus deinem NIM-Katalog eintragen.
NIM_MODELS=meta/llama-3.1-8b-instruct,meta/llama-3.1-70b-instruct,google/gemma-2-27b-it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20240620
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_LLM_LIBRARY=cpu
OLLAMA_NO_CUDA=1
MAKE_WEBHOOK_URL=
MAKE_COMMAND_WEBHOOK_URL=
NETLIFY_SITE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Cloudflare queue API (Netlify proxy should use .../queue/enqueue).
TELEGRAM_QUEUE_URL=
TELEGRAM_QUEUE_TOKEN=
TELEGRAM_QUEUE_POLL_SECONDS=60
TELEGRAM_QUEUE_BATCH_SIZE=10
# Comma-separated process names that activate low-impact gaming mode.
JARVIS_GAME_PROCESSES=
JARVIS_CLAP_SENSITIVITY=5.0
JARVIS_API_URL=http://127.0.0.1:8787
GOOGLE_CALENDAR_CREDENTIALS=
MICROSOFT_GRAPH_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
OBSIDIAN_VAULT_PATH=
# Optional live-data fallbacks. Leave blank to use key-free providers only.
OPENWEATHER_API_KEY=
ALPHAVANTAGE_API_KEY=
NEWSAPI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
